# Normalise line endings on the way in, LF in the working tree.
* text=auto eol=lf
# Generated stubs. Marking them keeps them out of language statistics and
# collapses them by default in review, where a regenerated descriptor otherwise
# buries the two lines that actually changed.
worker/proto/*.pb.go              linguist-generated=true
router/src/readie_router/proto/*    linguist-generated=true
pkg/src/readie/_proto/*             linguist-generated=true
# Lockfiles are generated and reviewed for their diff summary, not line by line.
uv.lock                           linguist-generated=true
**/uv.lock                        linguist-generated=true
worker/go.sum                     linguist-generated=true
# Corpus and analysis data. Machine-written, and large enough that a diff is
# never the useful view.
pipeline/data/*.json              linguist-generated=true -diff
# Linguist skips docs/ as documentation by default. The docs site is a Docusaurus
# app, so its TypeScript and CSS count as source in the language statistics.
docs/src/**                       linguist-documentation=false
docs/docusaurus.config.ts         linguist-documentation=false
docs/sidebars.ts                  linguist-documentation=false
# Binary, so git must never try to merge or diff them as text.
*.png    binary
*.jpg    binary
*.gz     binary
*.tar    binary
*.whl    binary
pipeline/data/metadata/* filter=lfs diff=lfs merge=lfs -text
catalogues/* filter=lfs diff=lfs merge=lfs -text
# The README is plain text and must not be stored as an LFS pointer.
catalogues/README.md -filter -diff -merge text
