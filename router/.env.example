# Router configuration.
#
# Loaded automatically: the router's Settings (pydantic-settings) reads a `.env`
# in its working directory, and each field maps to the environment variable of
# the same name in upper case. Copy to `.env` and edit. Every value below is the
# built-in default, so a variable you leave unset behaves exactly as shown — the
# only ones a deployment must set are those that differ between environments.

# -- Identity and transport --------------------------------------------------
# Advertised name (how peers refer to this router); distinct from the bind host.
SERVICE_NAME=router
# gRPC listen port. 0 asks the OS for an ephemeral port (how tests avoid races).
PORT=50051
# Address the server binds. 0.0.0.0 binds every interface, which is the point.
BIND_HOST=0.0.0.0
# Cap on concurrent RPCs. Unset (blank) means no limit.
# MAX_CONCURRENT_RPCS=
# gRPC message size cap, in bytes (default 16 MiB).
MAX_MESSAGE_BYTES=16777216

# -- Placement ---------------------------------------------------------------
# Fraction of a worker's memory the router is willing to commit (0 < x <= 1).
MEMORY_HEADROOM=0.9
# Memory budget, in bytes, for a request whose @remote decorator sets none
# (default 512 MiB). The worker maps it onto the container's memory limit and
# auto-expands from there when the container needs more.
DEFAULT_MEMORY=536870912

# Size-vs-time weight (seconds per MB) for request-time checkpoint selection:
# the router picks the checkpoint minimising alpha*size + residual load time.
# MUST match the pipeline's alpha (the value the planner built the checkpoints
# under). Default 0.002.
ALPHA=0.002

# Directory of per-flavor <flavor>.json checkpoint catalogues (produced by
# `make generation`, mounted here). Empty/absent means no request-time
# selection — every cold start is uncheckpointed.
# CRFS_CATALOGUE_DIR=/var/lib/crfs/catalogues

# -- Session serialisation ---------------------------------------------------
# How long a request waits for its session's turn. A session pins to one paused
# container behind one socket, so concurrent calls for it must serialise.
SESSION_WAIT_TIMEOUT=60.0

# -- Execution ---------------------------------------------------------------
EXECUTION_TIMEOUT=3600.0

# -- Liveness and eviction ---------------------------------------------------
# Idle workers send nothing, so liveness is probed rather than inferred.
PROBE_INTERVAL=5.0
PROBE_TIMEOUT=2.0
PROBE_FAILURE_THRESHOLD=3
REAPER_INTERVAL=5.0
WORKER_TTL=30.0
EXECUTOR_TTL=600.0
EXECUTOR_ERROR_TTL=60.0
SESSION_TTL=1800.0
MAX_SESSIONS=10000

# -- Lifecycle ---------------------------------------------------------------
# Time allowed to drain in-flight calls on SIGTERM before the server is forced.
SHUTDOWN_GRACE=25.0

# -- Security (opt-in; unset = plaintext, no auth) ---------------------------
# Bearer token required on ProxyService (the only path that runs code). Give the
# same value to clients as CRFS_AUTH_TOKEN. Unset means no authorization.
# AUTH_TOKEN=change-me
# PEM cert + key to serve TLS on the router's port. Both must be set. Clients
# then set CRFS_TLS/CRFS_TLS_CA and workers set ROUTER_TLS_CA to verify it.
# TLS_CERT_FILE=/etc/crfs/tls/router.crt
# TLS_KEY_FILE=/etc/crfs/tls/router.key

# -- Observability -----------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=json
