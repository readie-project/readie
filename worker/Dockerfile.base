# The worker's base layer: runsc, grpcurl and the one executor root filesystem.
#
# Split out from the worker image for one measured reason. `COPY --from=<image>`
# produces a *fresh* layer every build: two otherwise-identical worker builds
# were observed to differ in the 25.9 GB rootfs layer's digest, so regenerating
# checkpoints would re-upload all of it. A layer *inherited* from a base image
# has the same digest by definition, so every generation shares it and a push
# carries only the binaries and the checkpoints.
#
# It also makes a per-generation build take seconds instead of eleven minutes,
# because the 26 GB copy does not happen at all.
#
# Rebuild it only when the rootfs or the pinned runsc release changes:
#
#   make worker-base
#
# grpcurl backs the compose healthcheck. The archive is architecture-specific,
# so derive it rather than pinning one.
FROM debian:bookworm-slim AS tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) GRPCURL_ARCH=x86_64 ;; \
        arm64) GRPCURL_ARCH=arm64  ;; \
        *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && wget -qO- "https://github.com/fullstorydev/grpcurl/releases/download/v1.9.3/grpcurl_1.9.3_linux_${GRPCURL_ARCH}.tar.gz" \
       | tar -xz -C /usr/local/bin grpcurl

# gVisor, pinned by release.
#
# The apt package is deliberately avoided: its postinst edits
# /etc/docker/daemon.json, which is meaningless inside an image, and the
# repository only ever serves the latest build. gVisor's checkpoint format is
# not stable across releases, so a floating runsc would silently invalidate
# every checkpoint on the next rebuild.
FROM debian:bookworm-slim AS runsc
ARG TARGETARCH
ARG GVISOR_RELEASE=20260721
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
         amd64) GVISOR_ARCH=x86_64  ;; \
         arm64) GVISOR_ARCH=aarch64 ;; \
         *) echo "gVisor publishes no build for ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && URL="https://storage.googleapis.com/gvisor/releases/release/${GVISOR_RELEASE}/${GVISOR_ARCH}" \
    && wget -q "${URL}/runsc" "${URL}/runsc.sha512" \
    && sha512sum -c runsc.sha512 \
    && chmod 0755 runsc \
    && mv runsc /usr/local/bin/runsc \
    && rm -f runsc.sha512 \
    && rm -rf /var/lib/apt/lists/*

# The executor root filesystem. Defined once in rootfs/Dockerfile and consumed
# by both this image and the offline pipeline, so the tree a checkpoint is
# captured against and the tree it is restored into cannot drift.
FROM crfs-executor-rootfs:latest AS rootfs

# The executor root filesystem. Defined once in rootfs/Dockerfile and consumed
# by both this base and the offline pipeline, so the tree a checkpoint is
# captured against and the tree it is restored into cannot drift.
FROM crfs-executor-rootfs:latest AS rootfs

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tools /usr/local/bin/grpcurl /usr/local/bin/grpcurl
COPY --from=runsc /usr/local/bin/runsc   /usr/local/bin/runsc

# Fail the build rather than the deployment if the runtime is unusable.
RUN runsc --version

# /shared holds per-sandbox directories and OCI bundles, and is the one thing
# still a volume: it is writable runtime scratch. /run/crfs-runsc is the
# runtime's state directory, which this worker owns exclusively.
RUN mkdir -p /shared /run/crfs-runsc /var/log/runsc

# The one root filesystem every sandbox runs against.
COPY --from=rootfs / /var/lib/crfs/rootfs
