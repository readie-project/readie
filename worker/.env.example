# Worker configuration.
#
# Loaded automatically for local, non-container runs: the worker calls
# godotenv.Load() on startup and reads a `.env` in its working directory -
# UNLESS APP_ENV=production, in which case it skips the file and uses real
# environment variables only. The shipped image sets APP_ENV=production and bakes
# SERVICE_NAME/PORT/WORKER_DIR/ROUTER_URI/RUNSC_* in, so this file is for running
# the Go binary directly on a Linux/amd64 host, not for the compose worker.
#
# Copy to `.env` and edit. Values shown are defaults unless marked REQUIRED.

# -- Required (no default; startup fails if unset) ---------------------------
# gRPC listen port and the advertised service name; WorkerURI = SERVICE_NAME:PORT.
PORT=50052
SERVICE_NAME=worker
# Host root for per-container dirs and OCI bundles. Must be an absolute path.
WORKER_DIR=/shared
# The router's RegistryService endpoint this worker registers with.
ROUTER_URI=localhost:50051

# -- Identity ----------------------------------------------------------------
# Leave unset in a fleet only if a single worker is fine - the router indexes by
# whatever id a worker registers, so multiple workers must each set their own.
# WORKER_ID=worker-1

# -- Sandbox runtime ---------------------------------------------------------
# These must match what the checkpoints were captured under (see the pipeline);
# changing one silently invalidates every baked checkpoint.
RUNSC_BINARY=/usr/local/bin/runsc
RUNSC_ROOT=/run/readie-runsc
# none | sandbox | host. Executors must not reach the network, hence none.
SANDBOX_NETWORK=none
# Makes a socket bound inside the sandbox visible on the host; the executor is a
# socket server, so anything other than create makes every execution fail at dial.
SANDBOX_HOST_UDS=create
# Copy-on-write over the shared read-only rootfs. Must never cover the socket
# mount: an `all:` overlay hides the socket and `:self` writes into the rootfs.
SANDBOX_OVERLAY=root:memory
# SANDBOX_PLATFORM=
# SANDBOX_DEBUG=false
# SANDBOX_DEBUG_LOG_DIR=/var/log/runsc
# Disable cgroup enforcement where delegation is unavailable (e.g. Docker Desktop).
SANDBOX_IGNORE_CGROUPS=false
# CGROUP_PARENT=/readie

# -- Capacity (reported to the router for scheduling) ------------------------
# Byte budget handed to executors. Accepts a suffix: 8Gi, 512Mi, 4GB.
WORKER_MEM_TOTAL=4Gi
# Concurrent-container cap. 0 means unbounded.
WORKER_MAX_EXECUTORS=0

# -- Flavor and GPU ----------------------------------------------------------
# "cpu" (CPU-only) or "gpu" (CPU + GPU). Advertised to the router: GPU requests
# go only to gpu workers; cpu requests prefer cpu workers. A gpu worker must run
# the gpu generation image (Kaggle GPU rootfs + baked GPU checkpoints).
WORKER_FLAVOR=cpu
# GPU device memory this worker offers, in bytes (suffixes ok: 16Gi). The router
# places GPU requests on this headroom. Zero on a cpu worker.
# WORKER_GPU_TOTAL=16Gi
# Enable gVisor nvproxy + the NVIDIA sandbox env. Defaults to true when
# WORKER_FLAVOR=gpu; set explicitly only to override. Must match the sandbox the
# checkpoints were captured under (it is in the fingerprint).
# SANDBOX_GPU=true

# -- Memory auto-expand ------------------------------------------------------
# Memory limit for a request that carries no memory budget (accepts a suffix).
DEFAULT_CONTAINER_MEM=512Mi
# When a container's memory use crosses MEM_GROWTH_THRESHOLD of its limit, the
# worker raises the limit by MEM_GROWTH_FACTOR, up to the request's max budget
# or, when it sets none, WORKER_MEM_TOTAL x the router's memory headroom.
MEM_GROWTH_THRESHOLD=0.9
MEM_GROWTH_FACTOR=2.0

# -- Observability -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# -- Advanced tuning (uncomment to override; Go duration strings, e.g. 30s, 1h)
# At startup, if this worker's spec fingerprint or runsc version disagrees with
# the baked manifest, refuse the checkpoints (drop to cold-only, log an ERROR).
# Default true; set false to keep them and only warn, tolerating cold fallbacks.
# CHECKPOINT_STRICT_COMPAT=true
# STREAM_LOGS=true
# STREAM_STATS=true
# WORKER_UTILIZATION_INTERVAL=10s
# EXECUTION_TIMEOUT=1h
# DIAL_TOTAL_TIMEOUT=60s
# RESPONSE_IDLE_TIMEOUT=30s
# CHECKPOINT_TIMEOUT=5m
# RUNSC_COMMAND_TIMEOUT=30s
# CONTAINER_STOP_TIMEOUT=2s
# CLEANUP_TIMEOUT=30s
# SHUTDOWN_TIMEOUT=30s
# STATS_INTERVAL=1s

# Set to production to ignore this .env entirely and use real env vars only.
# APP_ENV=
