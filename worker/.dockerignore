# Load-bearing: this directory is the build context for Dockerfile, so anything
# listed here is invisible to the image build.

# Binaries. A locally built go-server would otherwise be copied in and then
# overwritten by the one the build produces.
bin/
go-server

# Dependencies
vendor/

# Environments
ENV/
env/
.env

# Project files
.git/
.gitignore
.dockerignore
Dockerfile

# Test and tooling artifacts
coverage.out
coverage.html
.golangci.yml

# OS files
.DS_Store
