# readie-evals configuration. Copy to `.env` (or export these) before running.

# --- The agent (required to fetch/adapt/generate/repair) ----------------------
# Claude on Azure AI Foundry, via the anthropic SDK's AnthropicFoundry client.
# The same variables the pipeline uses. AZURE_ENDPOINT is the Foundry Anthropic
# endpoint URL; AZURE_MODEL_NAME is the model / deployment name.
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_MODEL_NAME=

# --- Fetching real code (optional; needs the [fetch] extra) -------------------
# Kaggle: the API token from https://www.kaggle.com/settings/api ("Generate New
# Token").
KAGGLE_API_TOKEN=
# HuggingFace token, only for gated models. Public model cards need none.
# HF_TOKEN=

# --- Where the Readie client connects (the `run` phase) -----------------------
# The local stack after `make run-local`. For a remote/prod router set the host
# and turn TLS on.
# READIE_ROUTER_URI=localhost:50051
# READIE_TLS=false

# --- Harness knobs ------------------------------------------------------------
# Tasks to target per (source, category).
# READIE_EVALS_PER_CELL=3
# Per-call deadline in seconds, or "none".
# READIE_EVALS_TIMEOUT=120
# The @remote memory budget a task runs under unless it declares its own.
# READIE_EVALS_MEMORY=2Gi
# Override where the corpus, results file and reports live.
# READIE_EVALS_OUT_DIR=./out
