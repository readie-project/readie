# readie-client (the @remote SDK) configuration.
#
# Note: unlike the router and worker, this library does NOT auto-load a `.env` —
# it is imported into your own program, and pulling a dotenv loader into a user's
# process is a dependency they did not ask for. Settings.from_env() reads these
# from the process environment, so export them (or have your own app load this
# file). Kept here to document the READIE_* variables a client consumer can set.
# Values shown are the built-in defaults.

# host:port of the router's ProxyService. READIE_ROUTER_URI is preferred; plain
# ROUTER_URI is accepted as a fallback for older deployments.
READIE_ROUTER_URI=localhost:50051

# Deadline for a whole call, in seconds. Unset means no deadline.
# READIE_TIMEOUT=

# Payload bytes per stream message (default 1 MiB). Matches the executor's reads.
READIE_CHUNK_SIZE=1048576

# gRPC message cap, in bytes (default 16 MiB). Must exceed READIE_CHUNK_SIZE.
READIE_MAX_MESSAGE_BYTES=16777216

# Print executor output as it arrives, instead of only on failure.
# Truthy values: 1, true, yes, on.
READIE_STREAM_LOGS=true

# Bearer token for a router that requires one (matches the router's AUTH_TOKEN).
# Unset sends no authorization header.
# READIE_AUTH_TOKEN=change-me

# Connect over TLS. READIE_TLS_CA (a PEM CA bundle to verify the router) implies
# it; READIE_TLS=1 alone uses the system trust roots. Unset means plaintext.
# READIE_TLS=true
# READIE_TLS_CA=/etc/readie/tls/ca.crt
