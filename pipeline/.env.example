# Pipeline configuration (offline: corpus, analysis, planning, capture).
#
# The pipeline image bakes its paths and sandbox modes in (BASE_DIR,
# EXECUTOR_DIR, READIE_DATA_DIR, READIE_PLAN_DIR, ROOTFS_PYTHONPATH, SANDBOX_*), so a
# normal `make generation` needs none of this. This file is for local runs of
# individual subcommands - above all `readie-pipeline corpus`, which needs
# Anthropic API (via an Azure endpoint), Kaggle and Hugging Face credentials that are never baked into an image.
#
# `python-dotenv` is an optional extra used by corpus generation; load this with
# your runner (e.g. `uv run --env-file .env ...`) or export the vars. Copy to
# `.env` and edit. Non-corpus values shown are the built-in defaults.

# -- Corpus generation credentials (REQUIRED for `corpus`) -------------------
# Missing any of the first three fails corpus generation with a clear message.
AZURE_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic
AZURE_API_KEY=your-api-key
AZURE_MODEL_NAME=your-model-name

# -- Real-code sources (needed when a Kaggle / Hugging Face source has weight) --
# Kaggle access token from https://www.kaggle.com/settings/api ("Generate New Token").
KAGGLE_API_TOKEN=your-kaggle-token
HF_TOKEN=your-huggingface-token

# -- Corpus mix (all optional) ---------------------------------------------------
# Which flavor is built comes from FLAVOR (cpu or gpu), one per run.
# New items one run appends to the corpus (it is only ever added to).
# READIE_CORPUS_TOTAL=2000
# Override the default weights; 0 disables a source. Defaults weight the Kaggle
# sources 2, the Hugging Face sources 1.5 and the three agent_* sources 1.
# READIE_CORPUS_SOURCE_WEIGHTS=kaggle=3,agent_fix=0
# READIE_CORPUS_BATCH=10
# READIE_CORPUS_SEED=1
# Make fetched code runnable. Reads of files that do not exist become generated
# stand-in data; set READIE_CORPUS_REWRITE=0 to skip that and keep only the
# mechanical fixes of notebook syntax.
# READIE_CORPUS_REWRITE=1
# READIE_CORPUS_REWRITE_MAX_CHARS=60000
# READIE_CORPUS_REWRITE_WORKERS=6
