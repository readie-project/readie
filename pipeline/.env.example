# Pipeline configuration (offline: corpus, analysis, planning, capture).
#
# The pipeline image bakes its paths and sandbox modes in (BASE_DIR,
# EXECUTOR_DIR, CRFS_DATA_DIR, CRFS_PLAN_DIR, ROOTFS_PYTHONPATH, SANDBOX_*), so a
# normal `make generation` needs none of this. This file is for local runs of
# individual subcommands — above all `crfs-pipeline corpus`, which needs Azure
# OpenAI credentials that are never baked into an image.
#
# `python-dotenv` is an optional extra used by corpus generation; load this with
# your runner (e.g. `uv run --env-file .env ...`) or export the vars. Copy to
# `.env` and edit. Non-corpus values shown are the built-in defaults.

# -- Corpus generation credentials (REQUIRED for `corpus`) -------------------
# Missing any of the first three fails corpus generation with a clear message.
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your-api-key
AZURE_MODEL_NAME=your-deployment-name
AZURE_API_VERSION=2025-03-01-preview

# -- Planner knobs -----------------------------------------------------------
# greedy (weighted set cover, the default) | fixed (a configured package set)
CRFS_PLANNER=greedy
# Upper bound on how many checkpoints a plan may emit.
CRFS_MAX_CHECKPOINTS=8
# Per-checkpoint size budget, in MB.
CRFS_SIZE_BUDGET_MB=2048.0
# Size-vs-time weight (seconds per MB): the planner adds a package while it saves
# more than alpha*size. MUST match the router's ALPHA. Default 0.002.
CRFS_ALPHA=0.002
# Which generation this run produces: cpu or gpu. `make generation FLAVOR=gpu`
# sets it; a gpu run captures under nvproxy and records the matching fingerprint.
FLAVOR=cpu

# -- Paths and capture (baked into the image; override only for local runs) --
# Directory holding the committed corpus (dataset.json) and metadata.json.
# Defaults to the packaged pipeline/data.
# CRFS_DATA_DIR=
# The OCI bundle (config.json + rootfs) the sandbox runs.
# BASE_DIR=/app/executorfs
# Host-side build outputs (manifest.json, checkpoints/). Distinct from the
# sandbox's own /tmp EXECUTOR_DIR.
# EXECUTOR_DIR=/app/executor
# Where the plan and spec fingerprint go when they must stay out of the image.
# CRFS_PLAN_DIR=
# ROOTFS_PYTHONPATH=/lib/python3.12/dist-packages
# How long a sandbox may take to print READY_FOR_CHECKPOINT before capture fails.
# CRFS_READY_TIMEOUT=300.0
# OCISPEC_BINARY=/usr/local/bin/ocispec
# RUNSC_BINARY=runsc

# -- Sandbox modes (must match the worker's, or a restore fails on fingerprint)
# SANDBOX_NETWORK=none
# SANDBOX_HOST_UDS=create
# SANDBOX_OVERLAY=root:memory
