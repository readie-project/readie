# Root .env - read by Docker Compose for variable substitution.
#
# `docker compose up` automatically loads a `.env` in this directory and
# substitutes ${VAR} references in docker-compose.yml. These three are the only
# ones the compose file interpolates; every other setting is baked into the
# images or defaulted by the services themselves.
#
# Copy to `.env` and edit. Values shown are the compose defaults (the `:-`
# fallbacks in docker-compose.yml), so an unset variable behaves identically.

# Disable cgroup enforcement for the worker's sandboxes. Docker Desktop's cgroup
# v2 delegation refuses the subtree write runsc needs, so every sandbox create
# fails with "device or resource busy" unless this is true. Harmless on a host
# with proper delegation.
READIE_IGNORE_CGROUPS=true

# Memory budget this worker advertises to the router (accepts a byte count or a
# suffix: 8Gi, 512Mi, 4GB). The router schedules on it, so over-reporting makes
# it overcommit the worker and the failure is an OOM-killed sandbox mid-run.
READIE_WORKER_MEM_TOTAL=4Gi

# Cap on concurrent sandboxes (containers) on the worker. 0 means unbounded.
READIE_WORKER_MAX_EXECUTORS=8
