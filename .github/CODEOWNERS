/executor/              @illinoisdata
/worker/internal/executor/ @illinoisdata

# Anything that changes what a checkpoint can restore into.
/rootfs/                @illinoisdata
/worker/internal/artifact/ @illinoisdata
/worker/internal/runsc/spec.go @illinoisdata
